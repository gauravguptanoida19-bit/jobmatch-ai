# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobmatch?schema=public"

# NextAuth / Auth.js Configuration
NEXTAUTH_SECRET="your-nextauth-secret-key-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI-Compatible AI Services (Optional - Built-in fallback synthesizer active when not set)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"
